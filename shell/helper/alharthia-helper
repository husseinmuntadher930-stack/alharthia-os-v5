#!/usr/bin/env python3
"""Alharthia OS root helper — the only thing the UI may run as root (via sudo).
Every action is validated against an allow-list."""
import json, os, re, subprocess, sys

CATALOG = json.load(open("/opt/alharthia/catalog.json", encoding="utf-8"))
ENV = dict(os.environ, DEBIAN_FRONTEND="noninteractive", LANG="C.UTF-8")


def die(msg, code=2):
    print(msg, flush=True)
    sys.exit(code)


def run(cmd):
    p = subprocess.Popen(cmd, env=ENV, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    for line in p.stdout:
        print(line.rstrip(), flush=True)
    return p.wait()


def apt(action, app_id):
    spec = CATALOG["store"].get(app_id)
    if not spec or "apt" not in spec:
        die("unknown app")
    pkgs = spec["apt"]
    opts = ["-y", "-o", "APT::Status-Fd=1", "-o", "Dpkg::Use-Pty=0"]
    if action == "install":
        run(["apt-get", "update"])
        code = run(["apt-get", "install", "--no-install-recommends", *opts, *pkgs])
        if code != 0 and spec.get("apt_alt"):
            code = run(["apt-get", "install", "--no-install-recommends", *opts, *spec["apt_alt"]])
    else:
        code = run(["apt-get", "remove", *opts, *pkgs])
        if code == 0:
            run(["apt-get", "autoremove", "-y"])
    sys.exit(code)


def flatpak(action, ref):
    allowed = {v.get("flatpak") for v in CATALOG["store"].values() if v.get("flatpak")}
    if ref not in allowed:
        die("unknown flatpak")
    if action == "flatpak-install":
        if run(["which", "flatpak"]) != 0:
            run(["apt-get", "install", "-y", "flatpak"])
        run(["flatpak", "remote-add", "--if-not-exists", "flathub", "https://dl.flathub.org/repo/flathub.flatpakrepo"])
        sys.exit(run(["flatpak", "install", "-y", "--noninteractive", "flathub", ref]))
    sys.exit(run(["flatpak", "uninstall", "-y", "--noninteractive", ref]))


def is_usb_partition(dev):
    if not re.fullmatch(r"/dev/sd[a-z]\d*", dev):
        return False
    disk = re.sub(r"\d+$", "", dev)
    out = subprocess.run(["lsblk", "-dn", "-o", "TRAN,RM", disk], capture_output=True, text=True).stdout.split()
    return bool(out) and (out[0] == "usb" or (len(out) > 1 and out[1] == "1"))


def fmt(dev, fs, label):
    if not is_usb_partition(dev):
        die("refusing: not a USB device")
    root_src = subprocess.run(["findmnt", "-n", "-o", "SOURCE", "/"], capture_output=True, text=True).stdout.strip()
    if root_src.startswith(re.sub(r"\d+$", "", dev)):
        die("refusing: system disk")
    label = re.sub(r"[^A-Za-z0-9_ -]", "", label)[:11] or "USB"
    print("progress 10", flush=True)
    subprocess.run(["umount", "-q", dev])
    cmds = {"exfat": ["mkfs.exfat", "-L", label, dev], "vfat": ["mkfs.vfat", "-F", "32", "-n", label.upper(), dev],
            "ntfs": ["mkfs.ntfs", "-Q", "-L", label, dev], "ext4": ["mkfs.ext4", "-F", "-L", label, dev]}
    if fs not in cmds:
        die("bad fs")
    print("progress 40", flush=True)
    code = run(cmds[fs])
    if code == 0 and fs == "ext4":
        user = os.environ.get("SUDO_USER", "")
        if user:
            subprocess.run(["mkdir", "-p", "/tmp/alh-mnt"])
            subprocess.run(["mount", dev, "/tmp/alh-mnt"])
            subprocess.run(["chown", f"{user}:{user}", "/tmp/alh-mnt"])
            subprocess.run(["umount", "/tmp/alh-mnt"])
    print("progress 100", flush=True)
    sys.exit(code)


def tz(zone):
    if not re.fullmatch(r"[A-Za-z_]+(/[A-Za-z_]+)?", zone) or not os.path.exists(f"/usr/share/zoneinfo/{zone}"):
        die("bad timezone")
    sys.exit(run(["timedatectl", "set-timezone", zone]))


def airplay(state):
    """Turns the AirPlay receiver on/off — lets iPhone/iPad mirror onto this screen."""
    if state not in ("on", "off"):
        die("bad state")
    sys.exit(run(["systemctl", "start" if state == "on" else "stop", "alharthia-airplay"]))


def hotspot(state, psk):
    """3.0 — شبكة Wi-Fi خاصة بريموت المعلم (AlharthiaOS-Remote)."""
    if state not in ("on", "off") or not re.fullmatch(r"[a-z0-9]{8,32}", psk or ""):
        die("bad args")
    name = "alharthia-remote-ap"
    if state == "off":
        subprocess.run(["nmcli", "connection", "down", name], capture_output=True)
        sys.exit(0)
    have = subprocess.run(["nmcli", "-t", "-f", "NAME", "connection", "show"], capture_output=True, text=True).stdout.split("\n")
    if name not in have:
        code = run(["nmcli", "connection", "add", "type", "wifi", "ifname", "wlan0", "con-name", name, "autoconnect", "no",
                    "ssid", "AlharthiaOS-Remote", "802-11-wireless.mode", "ap", "802-11-wireless.band", "bg",
                    "ipv4.method", "shared", "ipv4.addresses", "10.56.0.1/24", "ipv6.method", "disabled",
                    "wifi-sec.key-mgmt", "wpa-psk", "wifi-sec.psk", psk])
        if code != 0:
            die("تعذر إنشاء الشبكة")
    else:
        run(["nmcli", "connection", "modify", name, "wifi-sec.psk", psk])
    sys.exit(run(["nmcli", "connection", "up", name]))


def checkpw():
    """يتأكد من كلمة مرور مستخدم النظام (من stdin) مقابل /etc/shadow — بدون ما يطبعها."""
    user = os.environ.get("SUDO_USER", "")
    pw = sys.stdin.readline().rstrip("\n")
    if not user or not pw:
        sys.exit(1)
    h = ""
    with open("/etc/shadow") as f:
        for ln in f:
            parts = ln.split(":")
            if parts[0] == user:
                h = parts[1]
                break
    if not h or h[0] in "!*":
        sys.exit(1)
    try:
        import crypt
        ok = crypt.crypt(pw, h) == h
    except Exception:  # noqa — بايثون بدون crypt
        r = subprocess.run(["perl", "-e", "print crypt($ARGV[0],$ARGV[1])", pw, h], capture_output=True, text=True)
        ok = r.stdout == h
    sys.exit(0 if ok else 1)


def usb_update(path):
    """3.0 — تحديث من فلاشة: يفك ملف alharthia-os-….zip ويشغّل سكربت التحديث مالته."""
    real = os.path.realpath(path)
    if not re.match(r"^/(media|run/media)/", real) or not re.fullmatch(r"(?i)alharthia-os[^/]*\.zip", os.path.basename(real)):
        die("refusing: not an update file on a USB drive")
    import tempfile, zipfile
    work = tempfile.mkdtemp(prefix="alh-upd-")
    print("progress 5", flush=True)
    with zipfile.ZipFile(real) as z:
        for n in z.namelist():
            if n.startswith("/") or ".." in n.split("/"):
                die("bad zip")
        z.extractall(work)
    print("progress 25", flush=True)
    cand = [os.path.join(dp, "update-on-pi.sh") for dp, dn, fn in os.walk(work) if "update-on-pi.sh" in fn and dp.endswith("tools")]
    if not cand:
        die("ملف التحديث ناقص (ماكو tools/update-on-pi.sh)")
    root = os.path.dirname(os.path.dirname(cand[0]))
    # نخلي نسخة المصدر بمكانها الدائم حتى التحديث الجاي يبدي منها
    dest = os.path.join(os.path.expanduser("~" + os.environ.get("SUDO_USER", "teacher")), "alharthia-os-src")
    subprocess.run(["rm", "-rf", dest + ".new"])
    subprocess.run(["cp", "-a", root, dest + ".new"])
    subprocess.run(["rm", "-rf", dest])
    subprocess.run(["mv", dest + ".new", dest])
    user = os.environ.get("SUDO_USER", "")
    if user:
        subprocess.run(["chown", "-R", f"{user}:{user}", dest])
    print("progress 40", flush=True)
    code = run(["bash", os.path.join(dest, "tools", "update-on-pi.sh")])
    print("progress 100", flush=True)
    sys.exit(code)


def main():
    if len(sys.argv) == 2 and sys.argv[1] == "checkpw":
        checkpw()
    if len(sys.argv) < 3:
        die("usage: alharthia-helper <action> <args>")
    action, args = sys.argv[1], sys.argv[2:]
    if action in ("install", "remove"):
        apt(action, args[0])
    elif action in ("flatpak-install", "flatpak-remove"):
        flatpak(action, args[0])
    elif action == "format" and len(args) == 3:
        fmt(*args)
    elif action == "timezone":
        tz(args[0])
    elif action == "airplay":
        airplay(args[0])
    elif action == "hotspot" and len(args) == 2:
        hotspot(*args)
    elif action == "usb-update":
        usb_update(args[0])
    else:
        die("unknown action")


if __name__ == "__main__":
    main()
