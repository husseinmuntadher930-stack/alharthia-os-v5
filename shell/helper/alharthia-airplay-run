#!/bin/bash
# مشغّل AirPlay — يجرب أكثر من طريقة عرض لأن الناتج يختلف حسب تعريف الشاشة.
# أي فشل ينطبع بالسجل حتى يبين بالواجهة:  journalctl -u alharthia-airplay
set -u
export GST_DEBUG=${GST_DEBUG:-1}
NAME="${ALH_AIRPLAY_NAME:-Alharthia}"

if ! command -v uxplay >/dev/null 2>&1; then
	echo "uxplay غير مثبت — نفّذ: sudo apt install uxplay" >&2
	exit 78
fi

# نتأكد من جلسة العرض
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -z "${DISPLAY:-}" ]; then
	for d in "${XDG_RUNTIME_DIR:-/run/user/1000}"/wayland-*; do
		[ -S "$d" ] || continue
		case "$d" in *.lock) continue ;; esac
		export WAYLAND_DISPLAY="$(basename "$d")"
		break
	done
fi
echo "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-} DISPLAY=${DISPLAY:-}" >&2

# avahi ضروري حتى يظهر الجهاز بقائمة «عكس الشاشة»
if ! pidof avahi-daemon >/dev/null 2>&1; then
	echo "تحذير: avahi-daemon مو شغّال — الآيفون ما راح يلگي الجهاز" >&2
fi

have_sink() { gst-inspect-1.0 "$1" >/dev/null 2>&1; }

SINKS=""
for s in waylandsink glimagesink gtkwaylandsink xvimagesink ximagesink; do
	have_sink "$s" && SINKS="$SINKS $s"
done
echo "أنواع العرض المتوفرة:${SINKS:- (ماكو — راح نستخدم الافتراضي)}" >&2

try() {
	echo "» تشغيل: uxplay $*" >&2
	uxplay "$@" &
	pid=$!
	# إذا عاش ٦ ثواني نعتبرها نجحت ونبقى وياها
	for _ in $(seq 1 12); do
		sleep .5
		kill -0 "$pid" 2>/dev/null || { wait "$pid"; return $?; }
	done
	wait "$pid"
	return $?
}

BASE=(-n "$NAME" -nh -fs)

for s in $SINKS; do
	try "${BASE[@]}" -vs "$s" && exit 0
	echo "فشل مع $s — نجرب غيره" >&2
done

# آخر محاولة: بدون تحديد نوع العرض
try "${BASE[@]}" && exit 0
echo "كل المحاولات فشلت — ثبّت حزم GStreamer: sudo apt install gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-gl gstreamer1.0-wayland" >&2
exit 1
