Window.SetBackgroundTopColor(0.043, 0.102, 0.271);
Window.SetBackgroundBottomColor(0.075, 0.145, 0.341);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(Window.GetY() + Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);

title.image = Image.Text("Alharthia OS", 1, 1, 1, 1, "Sans Bold 28");
title.sprite = Sprite(title.image);
title.sprite.SetX(Window.GetX() + Window.GetWidth() / 2 - title.image.GetWidth() / 2);
title.sprite.SetY(logo.sprite.GetY() + logo.image.GetHeight() + 30);

dot_image = Image("dot.png");
for (i = 0; i < 5; i++) {
  dots[i] = Sprite(dot_image);
  dots[i].SetY(title.sprite.GetY() + 70);
  dots[i].SetX(Window.GetX() + Window.GetWidth() / 2 - 50 + i * 22);
  dots[i].SetOpacity(0.3);
}
tick = 0;
fun refresh_callback() {
  tick++;
  for (i = 0; i < 5; i++) {
    if (Math.Int(tick / 8) % 5 == i) dots[i].SetOpacity(1); else dots[i].SetOpacity(0.3);
  }
}
Plymouth.SetRefreshFunction(refresh_callback);
