# Alharthia OS session
mkdir -p "$HOME/.local/share/alharthia"
/usr/bin/alharthia-keyboard-setup
command -v bt-agent >/dev/null && bt-agent -c NoInputNoOutput >/dev/null 2>&1 &
# fast ink: draws the fresh part of the line right under the finger (board / write over screen)
# 3.0: إذا وقف لأي سبب يرجع يشتغل وحده (وينكتب بسجل الأعطال)
(sleep 3; while true; do python3 /opt/alharthia/alharthia_ink.py; echo "$(date '+%F %T') ink stopped (exit $?) — restart" >>"$HOME/.local/share/alharthia/session.log"; sleep 10; done) >"$HOME/.local/share/alharthia-ink.log" 2>&1 &
# the Alharthia keyboard (same as the interface) above every program
(sleep 2; while true; do python3 /opt/alharthia/alharthia_osk.py; echo "$(date '+%F %T') keyboard stopped (exit $?) — restart" >>"$HOME/.local/share/alharthia/session.log"; sleep 10; done) >/dev/null 2>&1 &
/usr/bin/alharthia-session >/dev/null 2>&1 &
